<Window x:Class="AccountBook.WalletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:account_book"
        mc:Ignorable="d"
        Title="创建钱包" 
        Height="160" 
        Width="280"
        WindowStartupLocation="CenterOwner"
        Background="LightCyan"
        ShowInTaskbar="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!--钱包图片-->
        <Image 
            x:Name="WalletIcon" 
            Source="/Resources/wallet.jpg" 
            Height="100" Width="100" Grid.Column="0"
            MouseLeftButtonDown="SelectIcon"/>

        <!--钱包信息-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Label Content="名称：" Width="40" Height="25" Grid.Column="0" Grid.Row="0"/>
            <TextBox
                x:Name="WalletNameText"
                TextWrapping="NoWrap" 
                Width="120" Height="20" Grid.Column="1" Grid.Row="0"/>
            <Label Content="余额：" Width="40" Height="25" Grid.Column="0" Grid.Row="1"/>
            <TextBox 
                x:Name="WalletBalanceText"
                TextWrapping="NoWrap" 
                Width="120" Height="20" Grid.Column="1" Grid.Row="1"/>

            <!--保存钱包信息-->
            <Button 
                Content="OK" 
                Width="40" Height="20" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Grid.Column="1" Grid.Row="3"
                Click="CreateOrUPdate"/>
        </Grid>
    </Grid>
</Window>
