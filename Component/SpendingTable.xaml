<UserControl x:Class="AccountBook.Component.SpendingTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccountBook.Component"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!--TODO：消费账单的按钮、今日消费总计、本月消费总计、本年消费总计、历史消费总计-->
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Label>消费支出</Label>
            <Button Width="40">新建</Button>
            
            <Label>今日消费</Label>
            <Label>0.00</Label>
            <Label>元</Label>

            <Label>本周消费</Label>
            <Label>0.00</Label>
            <Label>元</Label>

            <Label>本月消费</Label>
            <Label>0.00</Label>
            <Label>元</Label>

            <Label>本年消费</Label>
            <Label>0.00</Label>
            <Label>元</Label>

            <Label>至今消费</Label>
            <Label>0.00</Label>
            <Label>元</Label>
        </StackPanel>
        
        <DataGrid Height="100" ItemsSource="{Binding Data}" AutoGenerateColumns="True" Grid.Row="1" CanUserAddRows="True"/>
    </Grid>
</UserControl>
