<Window x:Class="AccountBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="帅哥的钱包" 
        Height="980.4" 
        Width="1824"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--所有钱包-->
        <StackPanel Orientation="Vertical" Background="LightCyan" Grid.Row="0">
            <!--板块标题和新建钱包的按钮-->
            <StackPanel Orientation="Horizontal" Background="LightGray" Height="30">
                <Label FontSize="16">所有钱包余额</Label>
                <!--创建钱包的按钮-->
                <Button 
                    Content="新建"
                    Width="40" Height="30"
                    FontSize="16"
                    Click="NewWallet"/>
            </StackPanel>
            
            <!--列出所有钱包-->
            <StackPanel x:Name="WalletsPanel" Orientation="Horizontal" Background="LightGreen" Height="100"/>
        </StackPanel>
    </Grid>
</Window>
