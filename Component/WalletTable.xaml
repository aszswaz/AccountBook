<UserControl x:Class="AccountBook.Component.WalletTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccountBook.Component"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!--所有钱包-->
        <StackPanel Orientation="Vertical" Background="LightCyan" Grid.Row="0">
            <!--板块标题和新建钱包的按钮-->
            <StackPanel Orientation="Horizontal" Background="LightGray" Height="30">
                <Label FontSize="16">所有钱包余额</Label>
                <!--创建钱包的按钮-->
                <Button 
            Content="新建"
            Width="40" Height="30"
            FontSize="16"
            Click="NewWallet"/>
            </StackPanel>

            <!--列出所有钱包-->
            <StackPanel x:Name="WalletsPanel" Orientation="Horizontal" Background="LightGreen" Height="100"/>
        </StackPanel>
    </Grid>
</UserControl>
